# Required — Supabase project (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — registration transport: rpc | edge | auto (default: auto = RPC on web, Edge Function on native)
# EXPO_PUBLIC_REGISTRATION_MODE=auto

# Optional — client-side flag for AI support prompt copy (server decides real availability)
# EXPO_PUBLIC_AI_FEATURES_ENABLED=false

# ── Edge Function secrets (set via `supabase secrets set`, NOT in this file) ──
# AI_API_KEY=       Anthropic API key for generate-support-prompt (omit → static templates)
# AI_MODEL=         defaults to claude-opus-4-8
